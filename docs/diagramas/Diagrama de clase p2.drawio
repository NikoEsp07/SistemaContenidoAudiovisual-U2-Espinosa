        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\ndirection TB\n\nclass ContenidoAudiovisual {\n    &lt;&lt;abstract&gt;&gt;\n    -int contar\n    -String titulo\n    -int duracionEnMinutos\n    -String genero\n    -int id\n    +ContenidoAudiovisual(String, int, String)\n    +getTitulo() String\n    +getDuracionEnMinutos() int\n    +getGenero() String\n    +getId() int\n    +mostrarDetalles()* void\n}\n\nclass Pelicula {\n    -String estudio\n    -ArrayList~Actor~ actores\n    +Pelicula(String, int, String, String)\n    +agregarActor(Actor) void\n    +getActores() ArrayList\n    +mostrarDetalles() void\n}\n\nclass SerieDeTV {\n    -ArrayList~Temporada~ temporadas\n    +SerieDeTV(String, int, String)\n    +agregarTemporada(int, int, int) void\n    +getTemporadas() ArrayList\n    +mostrarDetalles() void\n}\n\nclass Documental {\n    -String tema\n    -ArrayList~Investigador~ investigadores\n    +Documental(String, int, String, String)\n    +getTema() String\n    +setTema(String) void\n    +agregarInvestigador(Investigador) void\n    +getInvestigadores() ArrayList\n    +mostrarDetalles() void\n}\n\nclass Actor {\n    -String nombre\n    -int edad\n    -String nacionalidad\n    +Actor(String, int, String)\n    +getNombre() String\n    +setNombre(String) void\n    +getEdad() int\n    +setEdad(int) void\n    +getNacionalidad() String\n    +setNacionalidad(String) void\n    +toString() String\n}\n\nclass Temporada {\n    -int numero\n    -int anioEstreno\n    -int episodios\n    +Temporada(int, int, int)\n    +getNumero() int\n    +setNumero(int) void\n    +getAnioEstreno() int\n    +setAnioEstreno(int) void\n    +getEpisodios() int\n    +setEpisodios(int) void\n    +toString() String\n}\n\nclass Investigador {\n    -String nombre\n    -String especialidad\n    -String institucion\n    +Investigador(String, String, String)\n    +getNombre() String\n    +setNombre(String) void\n    +getEspecialidad() String\n    +setEspecialidad(String) void\n    +getInstitucion() String\n    +setInstitucion(String) void\n    +toString() String\n}\n\nclass VideoMusical {\n    -String artista\n    -String album\n    -String productora\n    +VideoMusical(String, int, String, String, String, String)\n    +getArtista() String\n    +setArtista(String) void\n    +getAlbum() String\n    +setAlbum(String) void\n    +getProductora() String\n    +setProductora(String) void\n    +mostrarDetalles() void\n}\n\nclass ClaseVirtual {\n    -String instructor\n    -String plataforma\n    -String nivel\n    +ClaseVirtual(String, int, String, String, String, String)\n    +getInstructor() String\n    +setInstructor(String) void\n    +getPlataforma() String\n    +setPlataforma(String) void\n    +getNivel() String\n    +setNivel(String) void\n    +mostrarDetalles() void\n}\n\nContenidoAudiovisual &lt;|-- Pelicula\nContenidoAudiovisual &lt;|-- SerieDeTV\nContenidoAudiovisual &lt;|-- Documental\nContenidoAudiovisual &lt;|-- VideoMusical\nContenidoAudiovisual &lt;|-- ClaseVirtual\n\nPelicula \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Actor : asociacion\nSerieDeTV \&quot;1\&quot; *-- \&quot;0..*\&quot; Temporada : composicion\nDocumental \&quot;1\&quot; o-- \&quot;0..*\&quot; Investigador : agregacion\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="euUybFgpGt-sDsnxLjkR-1">
